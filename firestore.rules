rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ユーザー設定(オンボーディング表示済みなど)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // 蔵書は本人のみ読み書き可
    match /users/{uid}/books/{bookId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
